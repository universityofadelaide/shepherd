<?php

/**
 * @file
 * Install, update, and uninstall functions for the shp_time_restrictions module.
 */

/**
 * Implements hook_schema().
 */
function shp_time_restrictions_schema() {
  $schema['shp_time_restrictions_log'] = [
    'description' => 'Stores node actions with timestamps.',
    'fields' => [
      'id' => [
        'description' => 'Primary Key.',
        'type' => 'serial',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'nid' => [
        'description' => 'Node ID.',
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'action' => [
        'description' => 'Action performed on the node.',
        'type' => 'varchar',
        'length' => 255,
        'not null' => TRUE,
      ],
      'timestamp' => [
        'description' => 'Unix timestamp when the action occurred.',
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
    ],
    'primary key' => ['id'],
    'indexes' => [
      'nid' => ['nid'],
      'timestamp' => ['timestamp'],
    ],
  ];

  return $schema;
}
